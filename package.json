{
  "name": "@variousjs/create",
  "version": "3.3.3",
  "description": "VariousJS boilerplate",
  "bin": "bin/create.js",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "tsc --skipLibCheck --noemit && eslint . --ext .ts,.tsx,.js",
    "start": "NODE_ENV=development webpack --progress --config ./webpack/component.js & NODE_ENV=development webpack serve --config ./webpack/app.js --progress",
    "build": "webpack --progress --config ./webpack/base.js",
    "prepublishOnly": "node bin/copy.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/variousjs/boilerplate.git"
  },
  "keywords": [
    "template",
    "variousjs"
  ],
  "author": "LoeiFy <LoeiFy@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/variousjs/boilerplate/issues"
  },
  "homepage": "https://github.com/variousjs/boilerplate#readme",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.28.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@variousjs/registry": "^0.1.9",
    "@variousjs/various": "^5.2.1",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.3",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "html-webpack-plugin": "^5.6.6",
    "less": "^4.5.1",
    "less-loader": "^12.3.0",
    "style-loader": "^4.0.0",
    "typescript": "^5.4.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  }
}
