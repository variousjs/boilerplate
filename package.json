{
  "name": "@variousjs/create",
  "version": "3.4.0",
  "description": "VariousJS boilerplate",
  "type": "module",
  "bin": "bin/create.js",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "tsc --skipLibCheck --noemit",
    "start": "TARGET=components vite build --watch --mode development & vite --mode development",
    "build": "TARGET=components vite build --mode production",
    "preview": "npm run build && TARGET=preview vite preview",
    "prepublishOnly": "node bin/copy.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/variousjs/boilerplate.git"
  },
  "keywords": [
    "template",
    "variousjs"
  ],
  "author": "LoeiFy <LoeiFy@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/variousjs/boilerplate/issues"
  },
  "homepage": "https://github.com/variousjs/boilerplate#readme",
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@variousjs/various": "^6.0.1",
    "less": "^4.5.1",
    "react-router-dom": "^6.22.1",
    "typescript": "^5.4.2",
    "vite": "^8.1.5"
  }
}
